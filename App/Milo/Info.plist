<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Milo</string>
    <key>CFBundleIdentifier</key>
    <string>com.monomacaw.milo</string>
    <key>CFBundleName</key>
    <string>Milo</string>
    <key>CFBundleDisplayName</key>
    <string>Milo</string>
    <key>CFBundleIconFile</key>
    <string>MiloDark</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.0</string>
    <key>CFBundleVersion</key>
    <string>200</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>Milo needs to send Apple Events to manage privileged process-control actions you explicitly request.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 monomacaw. All rights reserved.</string>
