    <key>MiloPaddleEnvironment</key>
    <string>$(MILO_PADDLE_ENVIRONMENT)</string>
    <key>MiloPaddlePriceID</key>
    <string>$(MILO_PADDLE_PRICE_ID)</string>
    <key>MiloSupabaseURL</key>
    <string>https://monomacaw.com</string>
    <key>SUEnableDownloaderService</key>
    <true/>
    <key>SUEnableInstallerLauncherService</key>
    <false/>
    <key>SUFeedURL</key>
    <string>https://monomacaw.com/api/milo/update-feed</string>
    <key>SUPublicEDKey</key>
    <string>$(SPARKLE_PUBLIC_ED_KEY)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.monomacaw.milo.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>milo</string>
            </array>
        </dict>
    </array>
    <key>MiloSupabaseAnonKey</key>
    <string></string>
    <key>MiloLicensePublicKey</key>
    <string></string>
